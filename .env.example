ENVIRONMENT=development
DATABASE_URL=sqlite:///./portfolio.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# OBLIGATOIRE en production : 32 caractères minimum. Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Compte admin créé au 1er démarrage si les deux sont renseignés (mot de passe : 12 caractères min. en production)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Notification e-mail du formulaire de contact (optionnel : sans SMTP, les messages restent consultables dans /admin)
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
