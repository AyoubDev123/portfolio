{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API : installer",
      "type": "shell",
      "options": { "cwd": "${workspaceFolder}/Back-end" },
      "windows": { "command": "python -m venv .venv; .venv\\Scripts\\python -m pip install -r requirements-dev.txt" },
      "linux": { "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt" },
      "osx": { "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt" },
      "problemMatcher": []
    },
    {
      "label": "API : lancer",
      "type": "shell",
      "options": { "cwd": "${workspaceFolder}/Back-end" },
      "windows": { "command": ".venv\\Scripts\\python -m uvicorn app.main:app --reload" },
      "linux": { "command": ".venv/bin/python -m uvicorn app.main:app --reload" },
      "osx": { "command": ".venv/bin/python -m uvicorn app.main:app --reload" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Front : installer",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/Front-end" },
      "problemMatcher": []
    },
    {
      "label": "Front : lancer",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/Front-end" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Tout lancer (API + Front)",
      "dependsOn": ["API : lancer", "Front : lancer"],
      "problemMatcher": []
    },
    {
      "label": "Tests API",
      "type": "shell",
      "options": { "cwd": "${workspaceFolder}/Back-end" },
      "windows": { "command": ".venv\\Scripts\\python -m pytest" },
      "linux": { "command": ".venv/bin/python -m pytest" },
      "osx": { "command": ".venv/bin/python -m pytest" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests Front",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/Front-end" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
